{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/billing.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/billing/:path*",
      "destination": "/api/billing"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
